# =============================================================================
# Production Environment Variables Example — Personal Job Search OS
# =============================================================================
# Copy this file to .env on the production host under /opt/job-search/.env
# DO NOT commit real secrets to Git version control.
# =============================================================================

# System Configuration
OPENINGS_WEB_BIND=127.0.0.1
OPENINGS_WEB_PORT=8501
OPENINGS_DATA_DIR=/data

# Security Token (Optional: Send header Authorization: Bearer <OPENINGS_API_TOKEN>)
OPENINGS_API_TOKEN=your_secure_random_api_token_here

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# External Job Board API Keys (Optional)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
