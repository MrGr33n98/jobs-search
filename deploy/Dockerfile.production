# =============================================================================
# Production Dockerfile — Personal Job Search OS (Openings)
# =============================================================================
# Multi-stage build with deterministic dependency installation,
# unprivileged non-root runtime user (UID 1000), and healthcheck.
# =============================================================================

FROM python:3.12-slim-bookworm AS builder

WORKDIR /build

# Install build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install uv package manager
COPY --from=ghcr.io/astral-sh/uv:0.4.15 /uv /bin/uv

# Copy project files for dependency installation
COPY pyproject.toml uv.lock README.md ./
COPY src ./src

# Create virtual environment and install production dependencies
RUN uv venv /app/.venv && \
    . /app/.venv/bin/activate && \
    uv pip install --no-cache .

# =============================================================================
# Final Production Runtime Stage
# =============================================================================
FROM python:3.12-slim-bookworm AS final

# Environmental configuration
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    OPENINGS_DATA_DIR="/data" \
    OPENINGS_WEB_BIND="127.0.0.1" \
    OPENINGS_WEB_PORT="8501"

# Create unprivileged application user and directory structure
RUN groupadd -g 1000 openings && \
    useradd -u 1000 -g openings -m -s /bin/bash openings && \
    mkdir -p /app /data /data/config /data/attachments /data/logs && \
    chown -R openings:openings /app /data

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy virtual environment and source code from builder
COPY --from=builder --chown=openings:openings /app/.venv /app/.venv
COPY --chown=openings:openings pyproject.toml ./
COPY --chown=openings:openings src ./src

# Switch to unprivileged user
USER openings:openings

# Expose local web port
EXPOSE 8501

# Default healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD openings healthcheck || exit 1

# Entrypoint using tini for signal handling
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["openings", "web"]
